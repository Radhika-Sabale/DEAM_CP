    {
      "id": "circ-half-adder",
      "moduleId": "circuit-simulator",
      "difficulty": "easy",
      "title": "1-Bit Half Adder gate synthesis",
      "statement": "Analyze the schematic for a 1-bit Half Adder computing Sum (S = A ⊕ B) and Carry (Cout = AB).",
      "parameters": {
        "inputs": ["A", "B"],
        "outputs": ["S", "Cout"],
        "gateCount": 2
      },
      "steps": [
        {
          "key": "half-adder-gate-count",
          "prompt": "Determine the number of logic gates needed to build a 1-bit Half Adder (XOR for Sum, AND for Cout).",
          "expected": {
            "kind": "circuit-step",
            "value": 2
          },
          "kind": "circuit-step",
          "context": {
            "expectedValue": 2
          }
        }
      ],
      "finalAnswer": 2,
      "explanation": [
        "A 1-bit Half Adder computes Sum S = A XOR B using 1 XOR gate and Carry Cout = A AND B using 1 AND gate. Total: 2 logic gates."
      ],
      "learningObjective": "Synthesize arithmetic combinational functions into primitive logic gate topologies.",
      "tags": [
        "other"
      ],
      "projectSeed": {
        "targetModule": "circuit-simulator",
        "variables": ["A", "B"],
        "circuit": {
          "nodes": [
            { "id": "in_a", "kind": "input", "label": "A", "value": 0, "x": 80, "y": 100 },
            { "id": "in_b", "kind": "input", "label": "B", "value": 0, "x": 80, "y": 180 },
            { "id": "g_xor", "kind": "gate", "gateType": "XOR", "inputCount": 2, "x": 260, "y": 100 },
            { "id": "g_and", "kind": "gate", "gateType": "AND", "inputCount": 2, "x": 260, "y": 180 },
            { "id": "out_s", "kind": "output", "label": "S", "x": 440, "y": 100 },
            { "id": "out_cout", "kind": "output", "label": "Cout", "x": 440, "y": 180 }
          ],
          "wires": [
            { "id": "w1", "from": { "nodeId": "in_a", "pin": 0 }, "to": { "nodeId": "g_xor", "pin": 0 } },
            { "id": "w2", "from": { "nodeId": "in_b", "pin": 0 }, "to": { "nodeId": "g_xor", "pin": 1 } },
            { "id": "w3", "from": { "nodeId": "in_a", "pin": 0 }, "to": { "nodeId": "g_and", "pin": 0 } },
            { "id": "w4", "from": { "nodeId": "in_b", "pin": 0 }, "to": { "nodeId": "g_and", "pin": 1 } },
            { "id": "w5", "from": { "nodeId": "g_xor", "pin": 0 }, "to": { "nodeId": "out_s", "pin": 0 } },
            { "id": "w6", "from": { "nodeId": "g_and", "pin": 0 }, "to": { "nodeId": "out_cout", "pin": 0 } }
          ]
        }
      }
    },
    {
