    {
      "id": "circ-kmap-sop-implementation",
      "moduleId": "circuit-simulator",
      "difficulty": "medium",
      "title": "Circuit realization of minimized K-map expression F = A'B + CD",
      "statement": "Determine the logic gate count to implement the two-level SOP circuit for F = A'B + CD.",
      "parameters": {
        "expression": "A'B + CD",
        "variables": ["A", "B", "C", "D"],
        "gateCount": 4
      },
      "steps": [
        {
          "key": "sop-circuit-gate-count",
          "prompt": "Count the gates required to implement the minimized SOP expression F = A'B + CD using standard NOT, AND, and OR gates.",
          "expected": {
            "kind": "circuit-step",
            "value": 4
          },
          "kind": "circuit-step",
          "context": {
            "expectedValue": 4
          }
        }
      ],
      "finalAnswer": 4,
      "explanation": [
        "1 NOT gate generates A'. 2 AND gates compute the product terms A'B and CD. 1 OR gate combines the products into F = A'B + CD. Total: 1 + 2 + 1 = 4 gates."
      ],
      "learningObjective": "Translate minimized two-level SOP Boolean expressions into physical schematic netlists.",
