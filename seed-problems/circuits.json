    {
      "id": "circ-faulty-gate-diagnosis",
      "moduleId": "circuit-simulator",
      "difficulty": "hard",
      "title": "Faulty gate localization in combinational netlist",
      "statement": "In a 4-NAND implementation of 2-input XOR, gate g_nand1 is improperly wired as an AND gate, creating an output fault. Identify the faulty node ID.",
      "parameters": {
        "faultyNodeId": "g_nand1",
        "intendedGate": "NAND",
        "actualGate": "AND"
      },
      "steps": [
        {
          "key": "identify-faulty-node",
          "prompt": "Identify the node ID of the gate causing the simulation output to fail.",
          "expected": {
            "kind": "circuit-step",
            "value": "g_nand1"
          },
          "kind": "circuit-step",
          "context": {
            "expectedValue": "g_nand1"
          }
        }
      ],
      "finalAnswer": "g_nand1",
      "explanation": [
        "In a 4-NAND XOR configuration, the first stage gate g_nand1 must produce (AB)' to feed the cross-coupling inputs of g_nand2 and g_nand3. If g_nand1 produces AB instead of (AB)', the output fails when A=0, B=0, resulting in an incorrect output. Hence g_nand1 is the faulty gate."
      ],
      "learningObjective": "Diagnose structural schematic errors by comparing simulated gate outputs against golden truth tables.",
      "tags": [
        "other"
      ],
      "projectSeed": {
        "targetModule": "circuit-simulator",
        "variables": ["A", "B"],
        "circuit": {
          "nodes": [
            { "id": "in_a", "kind": "input", "label": "A", "value": 0, "x": 80, "y": 100 },
            { "id": "in_b", "kind": "input", "label": "B", "value": 0, "x": 80, "y": 220 },
            { "id": "g_nand1", "kind": "gate", "gateType": "AND", "inputCount": 2, "x": 220, "y": 160 },
            { "id": "g_nand2", "kind": "gate", "gateType": "NAND", "inputCount": 2, "x": 360, "y": 100 },
            { "id": "g_nand3", "kind": "gate", "gateType": "NAND", "inputCount": 2, "x": 360, "y": 220 },
            { "id": "g_nand4", "kind": "gate", "gateType": "NAND", "inputCount": 2, "x": 500, "y": 160 },
            { "id": "out_y", "kind": "output", "label": "OUT", "x": 640, "y": 160 }
          ],
          "wires": [
            { "id": "w1", "from": { "nodeId": "in_a", "pin": 0 }, "to": { "nodeId": "g_nand1", "pin": 0 } },
            { "id": "w2", "from": { "nodeId": "in_b", "pin": 0 }, "to": { "nodeId": "g_nand1", "pin": 1 } },
            { "id": "w3", "from": { "nodeId": "in_a", "pin": 0 }, "to": { "nodeId": "g_nand2", "pin": 0 } },
            { "id": "w4", "from": { "nodeId": "g_nand1", "pin": 0 }, "to": { "nodeId": "g_nand2", "pin": 1 } },
            { "id": "w5", "from": { "nodeId": "g_nand1", "pin": 0 }, "to": { "nodeId": "g_nand3", "pin": 0 } },
            { "id": "w6", "from": { "nodeId": "in_b", "pin": 0 }, "to": { "nodeId": "g_nand3", "pin": 1 } },
            { "id": "w7", "from": { "nodeId": "g_nand2", "pin": 0 }, "to": { "nodeId": "g_nand4", "pin": 0 } },
            { "id": "w8", "from": { "nodeId": "g_nand3", "pin": 0 }, "to": { "nodeId": "g_nand4", "pin": 1 } },
            { "id": "w9", "from": { "nodeId": "g_nand4", "pin": 0 }, "to": { "nodeId": "out_y", "pin": 0 } }
          ]
        }
      }
