      "id": "seq-detector-mealy-101-overlap",
      "moduleId": "sequential-designer",
      "difficulty": "medium",
      "title": "Mealy Sequence Detector for '101' Overlapping",
      "statement": "Synthesize an overlapping binary sequence detector for the pattern '101' using a Mealy finite state machine and D flip-flops.",
      "parameters": {
        "pattern": "101",
        "machine": "mealy",
        "overlapping": true,
        "flipFlop": "D"
      },
      "steps": [
        {
          "key": "s0-in1",
          "prompt": "Determine next state from S0 (00, initial) when input IN = 1.",
          "kind": "seq-state-table-cell",
          "expected": {
            "kind": "state-table-row",
            "nextState": "1"
          },
          "context": {
            "spec": {
              "kind": "detector",
              "pattern": "101",
              "machine": "mealy",
              "overlapping": true,
              "flipFlop": "D"
            },
            "code": 0,
            "input": 1,
            "field": "next"
          }
        },
        {
          "key": "s1-in0",
          "prompt": "Determine next state from S1 (01, seen '1') when input IN = 0.",
          "kind": "seq-state-table-cell",
          "expected": {
            "kind": "state-table-row",
            "nextState": "2"
          },
          "context": {
            "spec": {
              "kind": "detector",
              "pattern": "101",
              "machine": "mealy",
              "overlapping": true,
              "flipFlop": "D"
            },
            "code": 1,
            "input": 0,
            "field": "next"
          }
        },
        {
          "key": "s2-in1-next",
          "prompt": "Determine next state from S2 (10, seen '10') when input IN = 1 in overlapping mode.",
          "kind": "seq-state-table-cell",
          "expected": {
            "kind": "state-table-row",
            "nextState": "1"
          },
          "context": {
            "spec": {
              "kind": "detector",
              "pattern": "101",
              "machine": "mealy",
              "overlapping": true,
              "flipFlop": "D"
            },
            "code": 2,
            "input": 1,
            "field": "next"
          }
        },
        {
          "key": "s2-in1-out",
          "prompt": "Determine Mealy output Z from state S2 when input IN = 1.",
          "kind": "seq-state-table-cell",
          "expected": {
            "kind": "state-table-row",
            "output": "1"
          },
          "context": {
            "spec": {
              "kind": "detector",
              "pattern": "101",
              "machine": "mealy",
              "overlapping": true,
              "flipFlop": "D"
            },
            "code": 2,
            "input": 1,
            "field": "output"
          }
        },
        {
          "key": "eq-z",
          "prompt": "Derive the minimal Boolean equation for Mealy output Z.",
          "kind": "seq-equation",
          "expected": {
            "kind": "boolean-step",
            "resultingExpression": "Q1 & IN"
          },
          "context": {
            "spec": {
              "kind": "detector",
              "pattern": "101",
              "machine": "mealy",
              "overlapping": true,
              "flipFlop": "D"
            },
            "functionName": "Z"
          }
        },
        {
          "key": "eq-d1",
          "prompt": "Derive the minimal Boolean excitation equation for flip-flop input D1.",
          "kind": "seq-equation",
          "expected": {
            "kind": "boolean-step",
            "resultingExpression": "Q0 & !IN"
          },
          "context": {
            "spec": {
              "kind": "detector",
              "pattern": "101",
              "machine": "mealy",
              "overlapping": true,
              "flipFlop": "D"
            },
            "functionName": "D1"
          }
        }
      ],
      "finalAnswer": {
        "D1": "Q0 & !IN",
        "D0": "IN",
        "Z": "Q1 & IN"
      },
      "explanation": [
        "In state S0 (no bits matched), input 1 matches the first bit of '101', advancing to state S1.",
        "In state S1 (prefix '1' matched), input 0 matches the second bit, advancing to state S2 (matched '10').",
        "In state S2 with input 1, the full pattern '101' is detected. Because detection is overlapping, the trailing '1' serves as the starting bit of the next candidate sequence, looping back to state S1.",
        "In a Mealy machine, output Z activates asynchronously when the final matching bit IN = 1 arrives while in state S2 (Q1=1, Q0=0), giving Z = 1.",
        "The output equation asserts when in state S2 and IN = 1: Z = Q1 & IN.",
        "Next state bit Q1 is 1 only when transitioning to state S2 (from S1 with IN = 0), yielding D1 = Q0 & !IN."
      ],
      "learningObjective": "Synthesize a Mealy sequence detector with overlapping recognition and derive combinational equations for state and output variables.",
      "tags": ["wrong-excitation-table", "wrong-law-applied"],
      "projectSeed": {
