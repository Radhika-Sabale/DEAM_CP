          "prompt": "Derive the minimal next-state Boolean equation for D0.",
          "kind": "seq-equation",
          "expected": {
            "kind": "boolean-step",
            "resultingExpression": "!Q0"
          },
          "context": {
            "spec": {
              "kind": "counter",
              "modulus": 10,
              "direction": "up",
              "flipFlop": "D",
              "style": "sync"
            },
            "functionName": "D0"
