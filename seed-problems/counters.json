    {
      "id": "counter-custom-lockout-fix",
      "moduleId": "sequential-designer",
      "difficulty": "hard",
      "title": "Custom Sequence Counter with Lockout Analysis and Self-Correction",
      "statement": "Analyze a custom synchronous counter cycling through states 0->2->4->6->0 with JK flip-flops. Detect trapped unused states and apply an all-to-initial self-correcting fix.",
      "parameters": {
        "sequence": [0, 2, 4, 6],
        "flipFlop": "JK",
        "style": "sync"
      },
      "steps": [
        {
          "key": "trans-s2",
          "prompt": "Determine next state from state S2 (010) in the custom sequence.",
          "kind": "seq-state-table-cell",
          "expected": {
            "kind": "state-table-row",
            "nextState": "4"
          },
          "context": {
            "spec": {
              "kind": "counter",
              "direction": "custom",
              "sequence": [0, 2, 4, 6],
              "flipFlop": "JK",
              "style": "sync"
            },
            "code": 2,
            "field": "next"
          }
        },
        {
          "key": "lockout-before",
          "prompt": "Identify which unused states [1, 3, 5, 7] form an isolated lockout cycle when designed with unconstrained don't-cares.",
          "kind": "seq-lockout-claim",
          "expected": {
            "kind": "state-table-row",
            "lockedStates": [1, 3, 5, 7]
          },
          "context": {
            "spec": {
              "kind": "counter",
              "direction": "custom",
              "sequence": [0, 2, 4, 6],
              "flipFlop": "JK",
              "style": "sync"
            }
          }
        },
        {
          "key": "lockout-after",
          "prompt": "After redirecting unused states {1:0, 3:0, 5:0, 7:0} to initial state S0, verify the remaining locked states.",
          "kind": "seq-lockout-claim",
          "expected": {
            "kind": "state-table-row",
            "lockedStates": []
          },
          "context": {
            "spec": {
              "kind": "counter",
              "direction": "custom",
              "sequence": [0, 2, 4, 6],
              "flipFlop": "JK",
              "style": "sync"
            },
            "unusedRedirects": {
              "1": 0,
              "3": 0,
              "5": 0,
              "7": 0
            }
          }
        },
        {
          "key": "eq-j1-fixed",
          "prompt": "Derive the new excitation equation for J1 with all unused states redirected to S0.",
          "kind": "seq-equation",
          "expected": {
            "kind": "boolean-step",
            "resultingExpression": "!Q0"
          },
          "context": {
            "spec": {
              "kind": "counter",
              "direction": "custom",
              "sequence": [0, 2, 4, 6],
              "flipFlop": "JK",
              "style": "sync"
            },
            "unusedRedirects": {
              "1": 0,
              "3": 0,
              "5": 0,
              "7": 0
            },
            "functionName": "J1"
          }
        }
      ],
      "finalAnswer": {
        "lockedStatesBefore": [1, 3, 5, 7],
        "redirects": { "1": 0, "3": 0, "5": 0, "7": 0 },
        "lockedStatesAfter": []
      },
      "explanation": [
        "In the custom sequence, S2 (010) advances to S4 (100).",
        "When unused states [1, 3, 5, 7] are treated as unconstrained don't-cares, they form an isolated self-sustaining cycle (1->3->5->7->1), causing circuit lockout.",
        "Applying deterministic redirects {1:0, 3:0, 5:0, 7:0} ensures any stray power-on state safely recovers to operational state S0 within one clock pulse.",
        "Re-synthesizing the excitation functions with fixed redirects yields J1 = !Q0."
      ],
      "learningObjective": "Diagnose unused state lockout cycles in sequential circuits and apply deterministic redirects to guarantee a self-correcting design.",
      "tags": ["ignored-lockout-state", "wrong-excitation-table"],
      "projectSeed": {
        "flipFlopType": "JK",
        "sequentialSpec": {
          "kind": "counter",
          "direction": "custom",
          "sequence": [0, 2, 4, 6],
          "flipFlop": "JK",
          "style": "sync"
        }
      }
    }
