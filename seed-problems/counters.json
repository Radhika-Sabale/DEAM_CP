    {
      "id": "counter-mod8-down-t",
      "moduleId": "sequential-designer",
      "difficulty": "easy",
      "title": "Mod-8 Synchronous Down Counter with T Flip-Flops",
      "statement": "Design a 3-bit synchronous down counter cycling through states 7->6->5->4->3->2->1->0->7 using T flip-flops.",
      "parameters": {
        "modulus": 8,
        "direction": "down",
        "flipFlop": "T",
        "style": "sync"
      },
      "steps": [
        {
          "key": "trans-s0",
          "prompt": "Determine next state from S0 (000) in a down counter.",
          "kind": "seq-state-table-cell",
          "expected": {
            "kind": "state-table-row",
            "nextState": "7"
          },
          "context": {
            "spec": {
              "kind": "counter",
              "modulus": 8,
              "direction": "down",
              "flipFlop": "T",
              "style": "sync"
            },
            "code": 0,
            "field": "next"
          }
        },
        {
          "key": "trans-s7",
          "prompt": "Determine next state from S7 (111) in a down counter.",
          "kind": "seq-state-table-cell",
          "expected": {
            "kind": "state-table-row",
            "nextState": "6"
          },
          "context": {
            "spec": {
              "kind": "counter",
              "modulus": 8,
              "direction": "down",
              "flipFlop": "T",
              "style": "sync"
            },
            "code": 7,
            "field": "next"
          }
        },
        {
          "key": "eq-t0",
          "prompt": "Derive the simplified excitation Boolean equation for T0 (least-significant bit).",
          "kind": "seq-equation",
          "expected": {
            "kind": "boolean-step",
            "resultingExpression": "1"
          },
          "context": {
            "spec": {
              "kind": "counter",
              "modulus": 8,
              "direction": "down",
              "flipFlop": "T",
              "style": "sync"
            },
            "functionName": "T0"
          }
        },
        {
          "key": "eq-t1",
          "prompt": "Derive the simplified excitation Boolean equation for T1.",
          "kind": "seq-equation",
          "expected": {
            "kind": "boolean-step",
            "resultingExpression": "!Q0"
          },
          "context": {
            "spec": {
              "kind": "counter",
              "modulus": 8,
              "direction": "down",
              "flipFlop": "T",
              "style": "sync"
            },
            "functionName": "T1"
          }
        },
        {
          "key": "eq-t2",
          "prompt": "Derive the simplified excitation Boolean equation for T2 (most-significant bit).",
          "kind": "seq-equation",
          "expected": {
            "kind": "boolean-step",
            "resultingExpression": "!Q1 & !Q0"
          },
          "context": {
            "spec": {
              "kind": "counter",
              "modulus": 8,
              "direction": "down",
              "flipFlop": "T",
              "style": "sync"
            },
            "functionName": "T2"
          }
        }
      ],
      "finalAnswer": {
        "T0": "1",
        "T1": "!Q0",
        "T2": "!Q1 & !Q0"
      },
      "explanation": [
        "In down counting, state 0 (000) decrements with wraparound to state 7 (111).",
        "State 7 (111) decrements to state 6 (110).",
        "Bit Q0 toggles on every single clock pulse, so T0 is tied constantly to logic 1.",
        "In a down counter, bit Q1 must toggle whenever Q0 is 0, so T1 = !Q0 (or Q0').",
        "Bit Q2 must toggle only when both lower bits Q1 and Q0 are 0, giving T2 = !Q1 & !Q0 (or Q1'Q0')."
      ],
      "learningObjective": "Derive excitation equations for synchronous down counters using T flip-flops.",
      "tags": ["wrong-excitation-table", "wrong-law-applied"],
      "projectSeed": {
        "flipFlopType": "T",
        "sequentialSpec": {
          "kind": "counter",
          "modulus": 8,
          "direction": "down",
          "flipFlop": "T",
          "style": "sync"
        }
      }
